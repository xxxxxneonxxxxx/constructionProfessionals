{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tok-lead-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8000,http://127.0.0.1:8000,https://YOUR-DOMAIN.RU",
    "ALLOW_NO_ORIGIN": "false",
    "TURNSTILE_EXPECTED_HOSTNAME": "",
    "TURNSTILE_EXPECTED_ACTION": "lead",
    "TELEGRAM_CHAT_ID": "1801481418",
    "EMAIL_FROM": "leads@YOUR-DOMAIN.RU",
    "EMAIL_TO": "i4bon@mail.ru",
    "ENABLE_TELEGRAM": "true",
    "ENABLE_EMAIL": "true",
    "LOG_NOTIFICATIONS": "false"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "TELEGRAM_BOT_TOKEN",
      "LEAD_HASH_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LEAD_QUEUE",
        "queue": "tok-leads"
      }
    ],
    "consumers": [
      {
        "queue": "tok-leads",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "tok-leads-dead-letter"
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
